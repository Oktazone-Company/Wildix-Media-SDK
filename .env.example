# Local bind addresses and ports.
WILDIX_MEDIA_SIP_HOST=0.0.0.0
WILDIX_MEDIA_SIP_PORT=5060
WILDIX_MEDIA_SIP_TRANSPORT=tcp
WILDIX_MEDIA_RTP_HOST=0.0.0.0
WILDIX_MEDIA_RTP_PORT_START=5060
WILDIX_MEDIA_RTP_PORT_END=5060

# Public tunnel or server address advertised to Wildix.
WILDIX_MEDIA_ADVERTISED_SIP_HOST=your-public-host.example.com
WILDIX_MEDIA_ADVERTISED_SIP_PORT=12345
WILDIX_MEDIA_ADVERTISED_RTP_HOST=your-public-host.example.com
WILDIX_MEDIA_ADVERTISED_RTP_PORT_START=12345

# Wildix normally offers G.711 A-law and mu-law.
WILDIX_MEDIA_CODECS=PCMA,PCMU
WILDIX_MEDIA_PTIME_MS=20
WILDIX_MEDIA_AUDIO_QUEUE_FRAMES=250
WILDIX_MEDIA_SYMMETRIC_RTP=true

# This file is a template. The SDK reads process environment variables and does not
# automatically load a local .env file.
